# Copy to .env.local for local development. deploy.sh sets these automatically for the hosted build.
# Values come from ../.phact/outputs.json after a deploy (ApiUrl, Region, UserPoolId, UserPoolClientId).

# live = call the PHACT API; mock = simulate it in this browser with sample data.
# If unset: live when VITE_API_BASE_URL is set, otherwise mock.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
# Optional, for local testing only: a stand-in Cognito endpoint.
VITE_COGNITO_ENDPOINT=
